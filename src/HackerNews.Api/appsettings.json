{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "HackerNews": {
    "BaseUrl": "https://hacker-news.firebaseio.com/v0/",
    "SnapshotCacheSeconds": 60,
    "StoryCacheSeconds": 300,
    "MaxConcurrentRequests": 8,
    "MaxStories": 500
  },
  "AllowedHosts": "*"
}
